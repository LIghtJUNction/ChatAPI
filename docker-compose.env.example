# Copy this file to .env before running Docker Compose.
# Generate the two secrets with: openssl rand -base64 48
CHATAPI_MASTER_KEY=
CHATAPI_SESSION_SECRET=

CHATAPI_ADMIN_USERNAME=superadmin
CHATAPI_ADMIN_PASSWORD=

# Host port exposed by Docker Compose.
CHATAPI_PORT=5000
# Set this when serving through a public domain, for example https://chat.example.com.
CHATAPI_BASE_URL=
# Comma-separated browser origins allowed to carry cookies.
CHATAPI_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

CHATAPI_LOG_LEVEL=info
TZ=Asia/Shanghai

# Docker image build only. Overseas environments may use https://proxy.golang.org,direct.
GOPROXY=https://goproxy.cn,direct
